<Project Sdk="Microsoft.NET.Sdk">
  <!-- The style linter. It parses the repository sources with Roslyn and
       fails on a style violation, so the rules live in code, not in a
       config file that drifts from them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vaxquis.NanoYaml.StyleLint</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
</Project>
