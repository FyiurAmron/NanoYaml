<Project Sdk="Microsoft.NET.Sdk">
  <!-- The benchmark: random corpora in the NanoYaml subset, and a
       parse/serialize round trip per parser. run.sh drives the whole
       comparison; the StrictYAML runner is a Python script next to this. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>NanoYamlBench</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../NanoYaml.csproj" />
    <PackageReference Include="SharpYaml" Version="3.16.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
